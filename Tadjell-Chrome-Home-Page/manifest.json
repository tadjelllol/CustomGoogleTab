{
    "manifest_version": 3,
    "name": "Tadjell's Custom Tab",
    "version": "2.1",
    "description": "A custom new tab with random backgrounds and bookmarks.",
    "permissions": [
        "storage"
    ],
    "key": "",
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    }
}
